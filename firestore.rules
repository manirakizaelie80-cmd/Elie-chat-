rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Global Safety Net: Default-deny
    match /{document=**} {
      allow read, write: if false;
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isValidUsernameId(id) {
      return id is string && id.size() >= 3 && id.size() <= 50 && id.matches('^[a-z0-9_\\-]+$');
    }

    function isValidUser(data) {
      return data.keys().hasAll(['id', 'name', 'status'])
        && data.id is string && data.id.size() <= 128 && data.id.matches('^[a-zA-Z0-9_\\-]+$')
        && data.name is string && data.name.size() > 0 && data.name.size() <= 100
        && data.status in ['online', 'away', 'busy', 'in-call', 'offline']
        && (!('username' in data) || (data.username is string && data.username.size() <= 50))
        && (!('email' in data) || (data.email is string && data.email.size() <= 150))
        && (!('customStatus' in data) || (data.customStatus is string && data.customStatus.size() <= 150))
        && (!('avatar' in data) || (data.avatar is string && data.avatar.size() <= 500000))
        && (!('peerId' in data) || (data.peerId is string && data.peerId.size() <= 150))
        && (!('readReceiptsEnabled' in data) || data.readReceiptsEnabled is bool)
        && (!('lastActive' in data) || data.lastActive is number)
        && (!('lastSeen' in data) || data.lastSeen is number)
        && (!('createdAt' in data) || data.createdAt is number);
    }

    function isValidRoom(data) {
      return data.keys().hasAll(['id', 'name', 'type', 'createdById', 'createdAt'])
        && data.id is string && data.id.size() <= 128 && data.id.matches('^[a-zA-Z0-9_\\-]+$')
        && data.name is string && data.name.size() > 0 && data.name.size() <= 100
        && data.type in ['text', 'voice-video']
        && data.createdById is string && data.createdById.size() <= 128
        && data.createdAt is number
        && (!('description' in data) || (data.description is string && data.description.size() <= 500))
        && (!('createdByName' in data) || (data.createdByName is string && data.createdByName.size() <= 100))
        && (!('category' in data) || (data.category is string && data.category.size() <= 50))
        && (!('icon' in data) || (data.icon is string && data.icon.size() <= 10))
        && (!('isCustomGroup' in data) || data.isCustomGroup is bool)
        && (!('isPrivate' in data) || data.isPrivate is bool)
        && (!('requiresApproval' in data) || data.requiresApproval is bool)
        && (!('memberIds' in data) || data.memberIds is list)
        && (!('adminIds' in data) || data.adminIds is list);
    }

    function isValidMessage(data) {
      return data.keys().hasAll(['id', 'conversationId', 'targetId', 'senderId', 'senderName', 'timestamp'])
        && data.id is string && data.id.size() <= 128 && data.id.matches('^[a-zA-Z0-9_\\-]+$')
        && data.conversationId is string && data.conversationId.size() <= 150
        && data.targetId is string && data.targetId.size() <= 128
        && data.senderId is string && data.senderId.size() <= 128
        && data.senderName is string && data.senderName.size() > 0 && data.senderName.size() <= 100
        && data.timestamp is number
        && (!('isGroup' in data) || data.isGroup is bool)
        && (!('senderAvatar' in data) || (data.senderAvatar is string && data.senderAvatar.size() <= 1000))
        && (!('text' in data) || (data.text is string && data.text.size() <= 5000))
        && (!('mediaUrl' in data) || (data.mediaUrl is string && data.mediaUrl.size() <= 2000))
        && (!('mediaType' in data) || data.mediaType in ['image', 'video', 'file', 'audio'])
        && (!('fileName' in data) || (data.fileName is string && data.fileName.size() <= 256))
        && (!('fileSize' in data) || data.fileSize is number)
        && (!('voiceAudio' in data) || (data.voiceAudio is string && data.voiceAudio.size() <= 500000))
        && (!('voiceDuration' in data) || data.voiceDuration is number)
        && (!('status' in data) || data.status in ['sent', 'delivered', 'read'])
        && (!('readBy' in data) || data.readBy is list)
        && (!('readAt' in data) || data.readAt is number);
    }

    function isValidCall(data) {
      return data.keys().hasAll(['id', 'callerId', 'callerName', 'receiverId', 'type', 'status', 'createdAt'])
        && data.id is string && data.id.size() <= 128 && data.id.matches('^[a-zA-Z0-9_\\-]+$')
        && data.callerId is string && data.callerId.size() <= 128
        && data.callerName is string && data.callerName.size() <= 100
        && data.receiverId is string && data.receiverId.size() <= 128
        && data.type in ['audio', 'video']
        && data.status in ['calling', 'ringing', 'accepted', 'rejected', 'busy', 'ended']
        && data.createdAt is number
        && (!('callerAvatar' in data) || (data.callerAvatar is string && data.callerAvatar.size() <= 1000))
        && (!('isGroup' in data) || data.isGroup is bool)
        && (!('endedAt' in data) || data.endedAt is number);
    }

    function isValidInvitation(data) {
      return data.keys().hasAll(['id', 'groupId', 'groupName', 'inviterId', 'inviteeId', 'status', 'createdAt'])
        && data.id is string && data.id.size() <= 128
        && data.groupId is string && data.groupId.size() <= 128
        && data.groupName is string && data.groupName.size() <= 100
        && data.inviterId is string && data.inviterId.size() <= 128
        && data.inviteeId is string && data.inviteeId.size() <= 128
        && data.status in ['pending', 'accepted', 'declined', 'revoked']
        && data.createdAt is number
        && (!('groupIcon' in data) || (data.groupIcon is string && data.groupIcon.size() <= 10))
        && (!('inviterName' in data) || (data.inviterName is string && data.inviterName.size() <= 100))
        && (!('inviteeName' in data) || (data.inviteeName is string && data.inviteeName.size() <= 100))
        && (!('respondedAt' in data) || data.respondedAt is number)
        && (!('revokedBy' in data) || (data.revokedBy is string && data.revokedBy.size() <= 128))
        && (!('revokedAt' in data) || data.revokedAt is number);
    }

    function isValidJoinRequest(data) {
      return data.keys().hasAll(['id', 'groupId', 'groupName', 'requesterId', 'status', 'createdAt'])
        && data.id is string && data.id.size() <= 128
        && data.groupId is string && data.groupId.size() <= 128
        && data.groupName is string && data.groupName.size() <= 100
        && data.requesterId is string && data.requesterId.size() <= 128
        && data.status in ['pending', 'approved', 'rejected']
        && data.createdAt is number
        && (!('requesterName' in data) || (data.requesterName is string && data.requesterName.size() <= 100))
        && (!('requesterAvatar' in data) || (data.requesterAvatar is string && data.requesterAvatar.size() <= 1000))
        && (!('reviewedBy' in data) || (data.reviewedBy is string && data.reviewedBy.size() <= 128))
        && (!('reviewedAt' in data) || data.reviewedAt is number);
    }

    function isValidNotification(data) {
      return data.keys().hasAll(['id', 'recipientId', 'type', 'title', 'message', 'read', 'createdAt'])
        && data.id is string && data.id.size() <= 128
        && data.recipientId is string && data.recipientId.size() <= 128
        && data.type in ['message', 'invitation', 'join_request', 'request_approved', 'request_rejected']
        && data.title is string && data.title.size() <= 100
        && data.message is string && data.message.size() <= 300
        && data.read is bool
        && data.createdAt is number
        && (!('targetId' in data) || (data.targetId is string && data.targetId.size() <= 128))
        && (!('isGroup' in data) || data.isGroup is bool)
        && (!('senderId' in data) || (data.senderId is string && data.senderId.size() <= 128))
        && (!('senderName' in data) || (data.senderName is string && data.senderName.size() <= 100));
    }

    function getRoom(roomId) {
      return get(/databases/$(database)/documents/rooms/$(roomId)).data;
    }

    function isRoomAdmin(room, userId) {
      return room.createdById == userId || (('adminIds' in room) && room.adminIds is list && (userId in room.adminIds));
    }

    function isRoomMember(room, userId) {
      return room.isPrivate != true 
        || room.createdById == userId 
        || (('memberIds' in room) && room.memberIds is list && (userId in room.memberIds))
        || (('adminIds' in room) && room.adminIds is list && (userId in room.adminIds));
    }

    // Public user directory for Elie Chat global presence & discovery
    match /users/{userId} {
      allow read: if true;
      allow create, update: if isValidId(userId) && isValidUser(request.resource.data) && request.resource.data.id == userId;
      allow delete: if false;
    }

    // Unique username registry
    match /usernames/{username} {
      allow read: if true;
      allow create: if isValidUsernameId(username)
        && request.resource.data.keys().hasAll(['username', 'uid'])
        && request.resource.data.username == username
        && request.resource.data.uid is string;
      allow update: if false;
      allow delete: if false;
    }

    // Channels and groups
    match /rooms/{roomId} {
      allow read: if true;
      allow create: if isValidId(roomId) && isValidRoom(request.resource.data) && request.resource.data.id == roomId;
      allow update: if isValidId(roomId) && isValidRoom(request.resource.data) && request.resource.data.id == roomId
        && request.resource.data.createdById == resource.data.createdById;
      allow delete: if isValidId(roomId);
    }

    // Real-time persistent messages (private group messages guarded for members only)
    match /messages/{messageId} {
      allow read: if true;
      allow create: if isValidId(messageId) && isValidMessage(request.resource.data) && request.resource.data.id == messageId
        && (!request.resource.data.isGroup || isRoomMember(getRoom(request.resource.data.targetId), request.resource.data.senderId));
      allow update: if isValidId(messageId) && isValidMessage(request.resource.data) && request.resource.data.id == messageId;
      allow delete: if isValidId(messageId);
    }

    // Group invitations: any active member can invite; admins or inviter can revoke
    match /group_invitations/{invitationId} {
      allow read: if true;
      allow create: if isValidId(invitationId) && isValidInvitation(request.resource.data) && request.resource.data.id == invitationId
        && request.resource.data.status == 'pending'
        && isRoomMember(getRoom(request.resource.data.groupId), request.resource.data.inviterId)
        && !isRoomMember(getRoom(request.resource.data.groupId), request.resource.data.inviteeId)
        && request.resource.data.inviterId != request.resource.data.inviteeId;
      allow update: if isValidId(invitationId) && isValidInvitation(request.resource.data) && request.resource.data.id == invitationId
        && resource.data.status == 'pending'
        && request.resource.data.groupId == resource.data.groupId
        && request.resource.data.inviteeId == resource.data.inviteeId
        && request.resource.data.inviterId == resource.data.inviterId
        && (
          (request.resource.data.status in ['accepted', 'declined']) ||
          (request.resource.data.status == 'revoked' && (isRoomAdmin(getRoom(resource.data.groupId), request.resource.data.revokedBy) || request.resource.data.revokedBy == resource.data.inviterId))
        );
      allow delete: if isValidId(invitationId);
    }

    // Join requests: created in pending; ONLY authorized group administrators can approve or reject
    match /join_requests/{requestId} {
      allow read: if true;
      allow create: if isValidId(requestId) && isValidJoinRequest(request.resource.data) && request.resource.data.id == requestId
        && request.resource.data.status == 'pending'
        && !isRoomMember(getRoom(request.resource.data.groupId), request.resource.data.requesterId);
      allow update: if isValidId(requestId) && isValidJoinRequest(request.resource.data) && request.resource.data.id == requestId
        && resource.data.status == 'pending'
        && request.resource.data.groupId == resource.data.groupId
        && request.resource.data.requesterId == resource.data.requesterId
        && (request.resource.data.status in ['approved', 'rejected'])
        && request.resource.data.reviewedBy is string
        && isRoomAdmin(getRoom(resource.data.groupId), request.resource.data.reviewedBy);
      allow delete: if isValidId(requestId);
    }

    // In-app notifications
    match /notifications/{notificationId} {
      allow read: if true;
      allow create: if isValidId(notificationId) && isValidNotification(request.resource.data) && request.resource.data.id == notificationId;
      allow update: if isValidId(notificationId) && isValidNotification(request.resource.data) && request.resource.data.id == notificationId;
      allow delete: if isValidId(notificationId);
    }

    // WebRTC Real-Time Call Signaling
    match /calls/{callId} {
      allow read: if true;
      allow create, update: if isValidId(callId) && isValidCall(request.resource.data) && request.resource.data.id == callId;
      allow delete: if isValidId(callId);

      match /callerCandidates/{candId} {
        allow read, write: if isValidId(callId) && isValidId(candId);
      }

      match /receiverCandidates/{candId} {
        allow read, write: if isValidId(callId) && isValidId(candId);
      }
    }
  }
}

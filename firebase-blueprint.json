{
  "entities": {
    "User": {
      "title": "User",
      "description": "User profile, presence and location information for Elie Chat users.",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique user ID (Firebase Auth UID)",
          "pattern": "^[a-zA-Z0-9_\\-]+$",
          "maxLength": 128
        },
        "name": {
          "type": "string",
          "description": "Display name of the user",
          "maxLength": 100
        },
        "username": {
          "type": "string",
          "description": "Unique lowercase username",
          "maxLength": 50
        },
        "avatar": {
          "type": "string",
          "description": "Avatar image URL or path",
          "maxLength": 500000
        },
        "email": {
          "type": "string",
          "description": "User email address if authenticated via Firebase Auth",
          "maxLength": 150
        },
        "status": {
          "type": "string",
          "description": "Real-time presence status",
          "enum": ["online", "away", "busy", "in-call", "offline"]
        },
        "customStatus": {
          "type": "string",
          "description": "Custom status tagline",
          "maxLength": 150
        },
        "readReceiptsEnabled": {
          "type": "boolean",
          "description": "Whether read receipts are transmitted to messaging peers"
        },
        "peerId": {
          "type": "string",
          "description": "Optional registered WebRTC peer ID",
          "maxLength": 150
        },
        "lastActive": {
          "type": "number",
          "description": "Timestamp in milliseconds of last active heartbeat"
        },
        "lastSeen": {
          "type": "number",
          "description": "Timestamp in milliseconds of last seen offline"
        },
        "createdAt": {
          "type": "number",
          "description": "Timestamp in milliseconds of user account registration"
        },
        "location": {
          "type": "object",
          "description": "Geographical location coordinates and country flag",
          "properties": {
            "city": { "type": "string", "maxLength": 100 },
            "country": { "type": "string", "maxLength": 100 },
            "flag": { "type": "string", "maxLength": 10 },
            "timezone": { "type": "string", "maxLength": 50 },
            "lat": { "type": "number" },
            "lng": { "type": "number" }
          }
        }
      },
      "required": ["id", "name", "status"]
    },
    "Username": {
      "title": "Username",
      "description": "Reserved unique username mappings to prevent collisions",
      "type": "object",
      "properties": {
        "username": {
          "type": "string",
          "description": "Normalized lowercase username",
          "maxLength": 50
        },
        "uid": {
          "type": "string",
          "description": "Owner user UID",
          "maxLength": 128
        },
        "createdAt": {
          "type": "number",
          "description": "Timestamp of reservation"
        }
      },
      "required": ["username", "uid"]
    },
    "Room": {
      "title": "Room",
      "description": "Public and user-created channels and group rooms for global chat and calling.",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique room/channel ID",
          "pattern": "^[a-zA-Z0-9_\\-]+$",
          "maxLength": 128
        },
        "name": {
          "type": "string",
          "description": "Channel or group display name",
          "maxLength": 100
        },
        "description": {
          "type": "string",
          "description": "Purpose and description of the channel/group",
          "maxLength": 500
        },
        "type": {
          "type": "string",
          "description": "Room medium type",
          "enum": ["text", "voice-video"]
        },
        "createdById": {
          "type": "string",
          "description": "ID of user who created the channel",
          "maxLength": 128
        },
        "createdByName": {
          "type": "string",
          "description": "Name of user who created the channel",
          "maxLength": 100
        },
        "createdAt": {
          "type": "number",
          "description": "Creation timestamp in milliseconds"
        },
        "isCustomGroup": {
          "type": "boolean",
          "description": "Flag identifying user-created group vs system default channel"
        },
        "isPrivate": {
          "type": "boolean",
          "description": "Flag determining whether group is private (requires invitation/approval) or public"
        },
        "requiresApproval": {
          "type": "boolean",
          "description": "Flag determining if joining requires administrator approval"
        },
        "icon": {
          "type": "string",
          "description": "Custom emoji or icon identifier",
          "maxLength": 10
        },
        "category": {
          "type": "string",
          "description": "Channel categorization tag",
          "maxLength": 50
        },
        "memberIds": {
          "type": "array",
          "description": "List of user IDs who are authorized members of this group",
          "items": { "type": "string", "maxLength": 128 }
        },
        "adminIds": {
          "type": "array",
          "description": "List of user IDs with administrative privileges in this group",
          "items": { "type": "string", "maxLength": 128 }
        }
      },
      "required": ["id", "name", "type", "createdById", "createdAt"]
    },
    "Message": {
      "title": "Message",
      "description": "Real-time persistent chat messages for 1-on-1 and group chats.",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique message ID",
          "pattern": "^[a-zA-Z0-9_\\-]+$",
          "maxLength": 128
        },
        "conversationId": {
          "type": "string",
          "description": "Conversation thread identifier (room_{roomId} or userA__userB sorted)",
          "maxLength": 150
        },
        "targetId": {
          "type": "string",
          "description": "Room ID or recipient User ID",
          "maxLength": 128
        },
        "isGroup": {
          "type": "boolean",
          "description": "Flag indicating group room vs private 1-on-1 direct message"
        },
        "senderId": {
          "type": "string",
          "description": "User ID of sender",
          "maxLength": 128
        },
        "senderName": {
          "type": "string",
          "description": "Display name of sender at time of sending",
          "maxLength": 100
        },
        "senderAvatar": {
          "type": "string",
          "description": "Avatar URL of sender",
          "maxLength": 1000
        },
        "text": {
          "type": "string",
          "description": "Message text body",
          "maxLength": 5000
        },
        "mediaUrl": {
          "type": "string",
          "description": "Optional image or attachment data/URL",
          "maxLength": 2000
        },
        "mediaType": {
          "type": "string",
          "description": "Type of attached media",
          "enum": ["image", "file"]
        },
        "voiceAudio": {
          "type": "string",
          "description": "Optional recorded voice note audio base64/URL",
          "maxLength": 500000
        },
        "voiceDuration": {
          "type": "number",
          "description": "Duration of voice audio note in seconds"
        },
        "status": {
          "type": "string",
          "description": "Delivery status of the message",
          "enum": ["sent", "delivered", "read"]
        },
        "readBy": {
          "type": "array",
          "description": "List of user IDs who have opened and read this message",
          "items": { "type": "string", "maxLength": 128 }
        },
        "readAt": {
          "type": "number",
          "description": "Timestamp in milliseconds when recipient read the message"
        },
        "timestamp": {
          "type": "number",
          "description": "Sent timestamp in milliseconds"
        }
      },
      "required": ["id", "conversationId", "targetId", "senderId", "senderName", "timestamp"]
    },
    "GroupInvitation": {
      "title": "GroupInvitation",
      "description": "Invitations sent by group members/admins to other users",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique invitation ID",
          "pattern": "^[a-zA-Z0-9_\\-]+$",
          "maxLength": 128
        },
        "groupId": { "type": "string", "maxLength": 128 },
        "groupName": { "type": "string", "maxLength": 100 },
        "groupIcon": { "type": "string", "maxLength": 10 },
        "inviterId": { "type": "string", "maxLength": 128 },
        "inviterName": { "type": "string", "maxLength": 100 },
        "inviteeId": { "type": "string", "maxLength": 128 },
        "inviteeName": { "type": "string", "maxLength": 100 },
        "status": {
          "type": "string",
          "enum": ["pending", "accepted", "declined", "revoked"]
        },
        "createdAt": { "type": "number" },
        "respondedAt": { "type": "number" },
        "revokedBy": { "type": "string", "maxLength": 128 },
        "revokedAt": { "type": "number" }
      },
      "required": ["id", "groupId", "groupName", "inviterId", "inviteeId", "status", "createdAt"]
    },
    "JoinRequest": {
      "title": "JoinRequest",
      "description": "Requests from users to join private/moderated groups",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique request ID",
          "pattern": "^[a-zA-Z0-9_\\-]+$",
          "maxLength": 128
        },
        "groupId": { "type": "string", "maxLength": 128 },
        "groupName": { "type": "string", "maxLength": 100 },
        "requesterId": { "type": "string", "maxLength": 128 },
        "requesterName": { "type": "string", "maxLength": 100 },
        "requesterAvatar": { "type": "string", "maxLength": 1000 },
        "status": {
          "type": "string",
          "enum": ["pending", "approved", "rejected"]
        },
        "createdAt": { "type": "number" },
        "reviewedBy": { "type": "string", "maxLength": 128 },
        "reviewedAt": { "type": "number" }
      },
      "required": ["id", "groupId", "groupName", "requesterId", "status", "createdAt"]
    },
    "Notification": {
      "title": "Notification",
      "description": "Real-time in-app alerts for messages, invitations, and join request decisions",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique notification ID",
          "pattern": "^[a-zA-Z0-9_\\-]+$",
          "maxLength": 128
        },
        "recipientId": { "type": "string", "maxLength": 128 },
        "type": {
          "type": "string",
          "enum": ["message", "invitation", "join_request", "request_approved", "request_rejected"]
        },
        "title": { "type": "string", "maxLength": 100 },
        "message": { "type": "string", "maxLength": 300 },
        "targetId": { "type": "string", "maxLength": 128 },
        "isGroup": { "type": "boolean" },
        "senderId": { "type": "string", "maxLength": 128 },
        "senderName": { "type": "string", "maxLength": 100 },
        "read": { "type": "boolean" },
        "createdAt": { "type": "number" }
      },
      "required": ["id", "recipientId", "type", "title", "message", "read", "createdAt"]
    },
    "Call": {
      "title": "Call",
      "description": "WebRTC real-time voice and video call session coordination.",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique call session ID",
          "pattern": "^[a-zA-Z0-9_\\-]+$",
          "maxLength": 128
        },
        "callerId": {
          "type": "string",
          "description": "User ID of caller",
          "maxLength": 128
        },
        "callerName": {
          "type": "string",
          "description": "Name of caller",
          "maxLength": 100
        },
        "callerAvatar": {
          "type": "string",
          "description": "Avatar of caller",
          "maxLength": 1000
        },
        "receiverId": {
          "type": "string",
          "description": "User ID of receiver",
          "maxLength": 128
        },
        "isGroup": {
          "type": "boolean",
          "description": "Flag indicating group call vs 1-on-1 call"
        },
        "type": {
          "type": "string",
          "description": "Audio voice vs video call",
          "enum": ["audio", "video"]
        },
        "status": {
          "type": "string",
          "description": "Current call connection state",
          "enum": ["calling", "ringing", "accepted", "rejected", "busy", "ended"]
        },
        "createdAt": {
          "type": "number",
          "description": "Timestamp when call initiated"
        },
        "endedAt": {
          "type": "number",
          "description": "Timestamp when call ended"
        }
      },
      "required": ["id", "callerId", "callerName", "receiverId", "type", "status", "createdAt"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "User",
      "description": "Stores user profiles, online presence, and location."
    },
    "/usernames/{username}": {
      "schema": "Username",
      "description": "Atomic reservation directory for unique usernames."
    },
    "/rooms/{roomId}": {
      "schema": "Room",
      "description": "Stores public channels and custom groups."
    },
    "/messages/{messageId}": {
      "schema": "Message",
      "description": "Stores persistent real-time messages for channels and direct chats."
    },
    "/group_invitations/{invitationId}": {
      "schema": "GroupInvitation",
      "description": "Stores group invitations sent to users."
    },
    "/join_requests/{requestId}": {
      "schema": "JoinRequest",
      "description": "Stores requests from users to join moderated or private groups."
    },
    "/notifications/{notificationId}": {
      "schema": "Notification",
      "description": "Stores in-app notifications for users."
    },
    "/calls/{callId}": {
      "schema": "Call",
      "description": "Stores WebRTC call signaling sessions."
    }
  }
}
